{
  "name": "phasekit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "build": "pnpm data:build && pnpm tokens:build && tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts --host 127.0.0.1",
    "lint": "eslint apps packages scripts tests --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data:add": "node --import tsx packages/refrigerant-data/scripts/cli.ts add",
    "data:validate": "node --import tsx packages/refrigerant-data/scripts/cli.ts validate",
    "data:build": "node --import tsx packages/refrigerant-data/scripts/cli.ts build",
    "data:coverage": "node --import tsx packages/refrigerant-data/scripts/cli.ts coverage",
    "tokens:build": "node --import tsx scripts/tokens.ts",
    "build:sites": "pnpm build && node scripts/sites-static.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3",
    "decimal.js": "^10.6.0",
    "idb": "^8.0.3",
    "intl-messageformat": "^12.1.2",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/huplifi/phasekit.git"
  },
  "homepage": "https://phasekit.app"
}
